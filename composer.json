{
    "name": "cboxdk/statamic-mcp",
    "description": "MCP (Model Context Protocol) server for Statamic CMS v6 — gives AI assistants structured access to content, blueprints, assets, and more.",
    "keywords": [
        "statamic",
        "mcp",
        "ai",
        "claude",
        "cursor",
        "development",
        "tools",
        "laravel"
    ],
    "homepage": "https://github.com/cboxdk/statamic-mcp",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Cboxdk\\StatamicMcp\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cboxdk\\StatamicMcp\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.6",
        "laravel/mcp": "^0.6 || ^0.7 || ^0.8 || ^0.9",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.1 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0",
        "laravel/pint": "^1.17",
        "larastan/larastan": "^3.0"
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "pint": "pint",
        "pint:test": "pint --test",
        "stan": "phpstan analyse --memory-limit=2G",
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "quality": [
            "@pint",
            "@stan",
            "@test"
        ],
        "qa": [
            "@pint:test",
            "@stan",
            "@test",
            "@license-check",
            "@composer audit --no-dev"
        ]
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic MCP Server",
            "description": "MCP server for Statamic CMS v6 — gives AI assistants structured access to content, blueprints, assets, and more."
        },
        "laravel": {
            "providers": [
                "Cboxdk\\StatamicMcp\\ServiceProvider"
            ]
        }
    },
    "suggest": {
        "laravel/boost": "Enhances the development experience when working with this Statamic MCP server by providing powerful Laravel-specific tools and debugging capabilities"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
